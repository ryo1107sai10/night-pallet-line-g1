# Generate one with: openssl rand -base64 32
MASTER_KEY=
# URL typed into the browser. HTTPS required except on loopback.
PUBLIC_ORIGIN=http://localhost:3000
# For npm start / npm run worker, use a non-owner NOBYPASSRLS role.
DATABASE_URL=postgresql://night_app:CHANGE_ME@127.0.0.1:5432/night
# Migration/first administrator only. Keep this out of the server environment.
MIGRATION_DATABASE_URL=postgresql://night_owner:CHANGE_ME@127.0.0.1:5432/night
