# Generate one with: openssl rand -base64 32
MASTER_KEY=
# URL typed into the browser. HTTPS required except on loopback.
PUBLIC_ORIGIN=http://localhost:3000
# Optional published booking connection opened at the public home URL.
PUBLIC_BOOKING_CONNECTION=
# For npm start / npm run worker, use a non-owner NOBYPASSRLS role.
DATABASE_URL=postgresql://night_app:CHANGE_ME@127.0.0.1:5432/night
# Migration/first administrator only. Keep this out of the server environment.
MIGRATION_DATABASE_URL=postgresql://night_owner:CHANGE_ME@127.0.0.1:5432/night
# Enable only in the dedicated pilot environment after LINE tests. Per-store switches default off.
AUTO_SEND_ENABLED=false

# LINE Marketplace module authorization. Set on the web service and worker.
# Redirect URI: PUBLIC_ORIGIN + /line-module/return
# Webhook URL: PUBLIC_ORIGIN + /api/v1/webhooks/line-module
LINE_MODULE_CHANNEL_ID=
LINE_MODULE_CHANNEL_SECRET=
LINE_MODULE_BOT_HEADER=

# Optional Google Calendar free/busy integration for interviews.
# Authorized redirect URI: PUBLIC_ORIGIN + /interview/google-return.html
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional Cloud Run free/busy binding for one explicitly shared store calendar.
GOOGLE_SHARED_CALENDAR_STORE=
GOOGLE_SHARED_CALENDAR_ID=
GOOGLE_SHARED_CALENDAR_ACCOUNT=
