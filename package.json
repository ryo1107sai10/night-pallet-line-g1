{
  "name": "night-pallet-line-g1",
  "version": "1.0.0",
  "description": "NIGHT pallet LINE G1",
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "build": "tsc && esbuild src/liff-client.ts --bundle --minify --format=esm --outfile=dist/assets/liff.js",
    "setup": "node --env-file-if-exists=.env dist/setup.js",
    "local": "node --env-file-if-exists=.env dist/local.js"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@line/liff": "2.32.0",
    "express": "5.3.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
